#Notifications 
exec mako

#Printscreen
bindsym  --release $mod+Shift+Print exec grim -g "$(slurp)" $HOME/Screenshots/screenshot$(date +"%Y%m%d%H%M").png

#Printscreen+swappy
bindsym  --release $mod+Print exec grim -g "$(slurp)" - | swappy -f - 

#Lockscreen
bindsym $mod+Shift+Delete exec /usr/bin/lock

#Brightness
     #Increase/Decrease screen brightness
     bindsym XF86MonBrightnessUp exec brightnessctl s +1%
     bindsym XF86MonBrightnessDown exec brightnessctl s 1%-

#ScreenSaver
bindsym $mod+Shift+o output eDP-1 disable
bindsym $mod+o output eDP-1 enable

#Sound control
     #Increase/Decrease sound volume
     bindsym XF86AudioRaiseVolume exec amixer -q set Master 5%+
     bindsym XF86AudioLowerVolume exec amixer -q set Master 5%-

     #Mute sound volume
     bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute 0 toggle
     bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute 0 toggle

#Sgtk-menu 
	bindsym $mod+x exec sgtk-bar -o 0.7

#Wlrportal
exec dbus-update-activation-environment DISPLAY I3SOCK SWAYSOCK WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY

exec /usr/lib/xdg-desktop-portal -r -v & /usr/lib/xdg-desktop-portal-wlr -r

exec /usr/lib/polkit-kde-authentication-agent-1
